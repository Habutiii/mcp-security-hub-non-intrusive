{
  "mcpServers": {
    "security-hub": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm", "--read-only",
        "--tmpfs", "/tmp:rw,size=128m",
        "--tmpfs", "/var/lib/security-hub:rw,size=512m",
        "--cap-drop=ALL", "--security-opt=no-new-privileges",
        "-e", "AGW_ALLOWED_TARGETS=example.com",
        "security-hub-agw:latest"
      ]
    }
  }
}
